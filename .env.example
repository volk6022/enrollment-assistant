# Конфигурация голосового ассистента приёмной комиссии.
# Скопировать в .env и заполнить.  cp .env.example .env
#
# Это ЕДИНСТВЕННОЕ место, откуда сервис берёт настройки: читается только в
# backend/config.py, обращения к os.environ в остальном коде запрещены (FR-32).

# ═══════════════════════════════════════════════════════════════════════════
# llama-server — поднимается НА ХОСТЕ, не в docker (scripts/serve-models.ps1|sh)
# Из контейнера хост доступен как host.docker.internal.
# ═══════════════════════════════════════════════════════════════════════════
LLM_ENDPOINT=http://host.docker.internal:20099
EMBEDDING_ENDPOINT=http://host.docker.internal:20100
RERANKER_ENDPOINT=http://host.docker.internal:20101

# Параметры слотов llama-server (для справки и для валидации на старте).
# -np 2 существует под пару «стрим ответа + ОДНО разовое решение», а не под
# параллельную нагрузку: два одновременных вызова дают x2.09 замедления.
LLM_N_PARALLEL=2
LLM_CONTEXT_SIZE=32000
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7
LLM_DECISION_TEMPERATURE=0.0
LLM_TIMEOUT_S=30

# ═══════════════════════════════════════════════════════════════════════════
# Модели. Сервис их НЕ СКАЧИВАЕТ, кроме whisper и silero (FR-31).
# Ссылки на GGUF-веса — в README, класть в MODELS_DIR вручную.
# ═══════════════════════════════════════════════════════════════════════════
MODELS_DIR=/models
LLM_MODEL_FILE=Qwopus3.5-4B-Q4_K_M.gguf
EMBEDDING_MODEL_FILE=bge-m3-Q8_0.gguf
RERANKER_MODEL_FILE=bge-reranker-v2-m3-Q8_0.gguf

# Whisper и silero качаются автоматически при первом запуске.
STT_MODEL=large-v3-turbo
STT_DEVICE=cuda            # cpu нежизнеспособен: RTF 5.24 против нужного <0.3
STT_COMPUTE_TYPE=int8
TTS_MODEL=v5_5_ru          # именно так называется модель в torch.hub, не "v5_5"
TTS_DEVICE=cpu             # RTF 0.070 на прогретой модели, VRAM освобождается под whisper
TTS_SPEAKER=xenia          # доступны: aidar, baya, kseniya, eugene, xenia
TTS_SAMPLE_RATE=48000

# ═══════════════════════════════════════════════════════════════════════════
# Аудио и VAD
# ═══════════════════════════════════════════════════════════════════════════
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE_MS=100
AUDIO_RING_SECONDS=60

# Преролл: детекция начала речи опаздывает, поэтому транскрибация начинается
# на столько миллисекунд РАНЬШЕ срабатывания VAD. Без него теряется первое слово.
VAD_PREROLL_MS=300
VAD_SILENCE_END_MS=500     # столько тишины = конец хода собеседника
VAD_THRESHOLD=0.5

# Потолок частичных транскрибаций. GPU их сериализует (4 одновременных = x4 времени),
# и они делят GPU с генерацией ответа. Поднимать осторожно — задушит LLM.
STT_PARTIAL_MAX_HZ=2.5
STT_WINDOW_SECONDS=15
STT_OVERLAP_SECONDS=2
STT_FINAL_PASS=false       # финальный полный прогон; выключен — экономит ~310 мс
STT_LANGUAGE=ru

# ═══════════════════════════════════════════════════════════════════════════
# Пороги диалога. Соответствуют порядковым порогам в specs/formal/dialogue.qnt:
# TALK_LIMIT / IDLE_LIMIT / OVERLAP_LIMIT / TAIL_MIN
# ═══════════════════════════════════════════════════════════════════════════
DIALOGUE_INTERJECT_AFTER_S=20
DIALOGUE_IDLE_HANGUP_S=2
DIALOGUE_BARGE_IN_OVERLAP_S=1
DIALOGUE_BARGE_IN_MIN_TAIL_S=2
DIALOGUE_CLARIFY_CONFIDENCE=0.6
TRANSCRIPT_BUFFER_CHARS=5000
DIALOGUE_HISTORY_MAX_TURNS=40
SCENARIOS_PATH=/app/dialogue/scenarios.yaml
GREETING_AUDIO_PATH=/app/assets/greeting.wav

# ═══════════════════════════════════════════════════════════════════════════
# RAG. top_k=10 — из сетки на 1200 тестов: значимый прирост против k=5
# (парный t=2.12), k=15/20 не окупают +1.8/+3.6 с префилла.
# ═══════════════════════════════════════════════════════════════════════════
RAG_TOP_K=10
RAG_FUSED_TOP=50
RAG_DENSE_TOP=20
RAG_BM25_TOP=20
RAG_RRF_K=60
RAG_MIN_SCORE=0.3          # ниже — считаем, что ответа в базе нет
RAG_MAX_LENGTH=256
RAG_BATCH_SIZE=32
FAISS_INDEX_PATH=/data/faiss_index
KB_SOURCE_PATH=/data/knowledge_base

# ═══════════════════════════════════════════════════════════════════════════
# API
# ═══════════════════════════════════════════════════════════════════════════
API_HOST=0.0.0.0
API_PORT=8000
WS_PING_INTERVAL_S=20
WS_PING_TIMEOUT_S=60
CORS_ORIGINS=http://localhost:3000
GUI_PORT=3000

# ═══════════════════════════════════════════════════════════════════════════
# Логи и телеметрия
# ═══════════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/dialogue.log
METRICS_ENABLED=true
TELEMETRY_ENDPOINT=        # пусто = телеметрия только в лог

# ═══════════════════════════════════════════════════════════════════════════
# Разработка
# ═══════════════════════════════════════════════════════════════════════════
DEBUG_STATE_MACHINE=false  # логировать каждый переход автомата
DEBUG_SAVE_DIALOGUES=      # каталог для дампов сессий; пусто = не сохранять
MOCK_LLM=false             # моки для unit-тестов; контрактные тесты требуют false
